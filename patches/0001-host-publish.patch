From 112a685cb38abc043ed0351fbd17a101cadb1094 Mon Sep 17 00:00:00 2001
From: MxxFoxx2 <126578124+MxxFoxx2@users.noreply.github.com>
Date: Mon, 26 Oct 2026 18:29:29 +0300
Subject: [PATCH 1/2] publish host

---
 build.gradle | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/build.gradle b/build.gradle
index 8c11279..d580329 100644
--- a/build.gradle
+++ b/build.gradle
@@ -2,6 +2,7 @@ plugins {
     id 'java-library'
     id 'net.neoforged.moddev' version '2.0.148'
     id 'idea'
+    id 'maven-publish'
 }
 
 tasks.named('wrapper', Wrapper).configure {
@@ -136,3 +137,20 @@ idea {
 tasks.named('runServer') {
     standardInput = System.in
 }
+
+publishing {
+    repositories {
+        maven {
+            name = "portLocal"
+            url = uri("../maven")
+        }
+    }
+    publications {
+        thaumcraft(MavenPublication) {
+            groupId = "thaumcraft"
+            artifactId = "thaumcraft"
+            version = project.mod_version
+            artifact tasks.named('jar')
+        }
+    }
+}
