From c3d21f8f2f8e1da36cde62e2b66f39db99a6d1a1 Mon Sep 17 00:00:00 2001
From: Mxx Foxx <tanjiro235@proton.me>
Date: Sat, 24 Oct 2026 22:30:00 +0600
Subject: [PATCH 3/3] build: publish patched Thaumcraft 1.21.1 artifact

---
 build.gradle | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/build.gradle b/build.gradle
index 71a8b13..e8fd50f 100644
--- a/build.gradle
+++ b/build.gradle
@@ -1,5 +1,6 @@
 plugins {
     id 'java-library'
     id 'net.neoforged.moddev' version '2.0.148'
     id 'idea'
+    id 'maven-publish'
 }
@@ -153,3 +154,20 @@
 tasks.named("runGameTestServer") {
     dependsOn prepareOuterLandsTests
 }
+
+publishing {
+    repositories {
+        maven {
+            name = "portLocal"
+            url = uri("../maven")
+        }
+    }
+    publications {
+        thaumcraft(MavenPublication) {
+            groupId = "thaumcraft"
+            artifactId = "thaumcraft"
+            version = project.mod_version
+            artifact tasks.named('jar')
+        }
+    }
+}
