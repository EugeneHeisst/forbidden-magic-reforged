From acb00ec829a07141cf77f90ca768dd591cfe12e6 Mon Sep 17 00:00:00 2001
From: Mxx Foxx <tanjiro235@proton.me>
Date: Wed, 21 Oct 2026 11:44:40 +0300
Subject: [PATCH] publish host

---
 build.gradle      | 18 ++++++++++++++++++
 gradle.properties |  2 +-
 2 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/build.gradle b/build.gradle
index 8c11279..d580329 100644
--- a/build.gradle
+++ b/build.gradle
@@ -2,6 +2,7 @@ plugins {
     id 'java-library'
     id 'net.neoforged.moddev' version '2.0.148'
     id 'idea'
+    id 'maven-publish'
 }
 
 tasks.named('wrapper', Wrapper).configure {
@@ -136,3 +137,20 @@ idea {
 tasks.named('runServer') {
     standardInput = System.in
 }
+
+publishing {
+    repositories {
+        maven {
+            name = "portLocal"
+            url = uri("../maven")
+        }
+    }
+    publications {
+        thaumcraft(MavenPublication) {
+            groupId = "thaumcraft"
+            artifactId = "thaumcraft"
+            version = project.mod_version
+            artifact tasks.named('jar')
+        }
+    }
+}
diff --git a/gradle.properties b/gradle.properties
index b131c1b..52a66d6 100644
--- a/gradle.properties
+++ b/gradle.properties
@@ -13,7 +13,7 @@ neo_version=26.3.0.57-beta
 mod_id=thaumcraft
 mod_name=Thaumcraft 4: Reforged
 mod_license=All Rights Reserved
-mod_version=1.1
+mod_version=1.2
 mod_group_id=thaumcraft
 mod_authors=Azanor (original), overseas (port)
 mod_credits=Special thanks to CovertJaguar, Dan Scott, Lorc, bonemouse, Scott Killen, Rorax and chicken_bones
-- 
