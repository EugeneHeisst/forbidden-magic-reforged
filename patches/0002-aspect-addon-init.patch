From: Mxx Foxx <tanjiro235@proton.me>
Date: Wed, 21 Oct 2026 11:44:17 +0300
Subject: [PATCH] add-on aspect hook

---
 .../java/thaumcraft/aspect/AddonAspects.java  | 35 +++++++++++++++++++
 .../java/thaumcraft/aspect/AspectSync.java    |  1 +
 2 files changed, 36 insertions(+)
 create mode 100644 src/main/java/thaumcraft/aspect/AddonAspects.java

diff --git a/src/main/java/thaumcraft/aspect/AddonAspects.java b/src/main/java/thaumcraft/aspect/AddonAspects.java
new file mode 100644
index 0000000..7915098
--- /dev/null
+++ b/src/main/java/thaumcraft/aspect/AddonAspects.java
@@ -0,0 +1,35 @@
+package thaumcraft.aspect;
+
+import java.util.List;
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.function.Consumer;
+import net.minecraft.resources.ResourceLocation;
+import javax.annotation.Nullable;
+
+public final class AddonAspects {
+    private static final List<Consumer<Addon>> REGISTRARS = new CopyOnWriteArrayList<>();
+    private static final Addon API = (tag, color, components, blend, texture) -> Aspect.register(tag, color, components, blend, texture);
+    private static boolean initialised;
+
+    private AddonAspects() {
+    }
+
+    public interface Addon {
+        Aspect register(String tag, int color, @Nullable Aspect[] components, int blend, @Nullable ResourceLocation texture);
+    }
+
+    public static void addRegistrar(Consumer<Addon> registrar) {
+        REGISTRARS.add(registrar);
+        if (initialised) {
+            registrar.accept(API);
+        }
+    }
+
+    public static void init() {
+        if (initialised) {
+            return;
+        }
+        initialised = true;
+        REGISTRARS.forEach(registrar -> registrar.accept(API));
+    }
+}
diff --git a/src/main/java/thaumcraft/aspect/AspectSync.java b/src/main/java/thaumcraft/aspect/AspectSync.java
index 2ea28c1..608cbbc 100644
--- a/src/main/java/thaumcraft/aspect/AspectSync.java
+++ b/src/main/java/thaumcraft/aspect/AspectSync.java
@@ -41,6 +41,7 @@ public final class AspectSync {
     public static void rebuild(MinecraftServer server) {
         long start = System.currentTimeMillis();
         AspectRegistry registry = new AspectRegistry(server);
+        AddonAspects.init();
         ModernAspects modern = new ModernAspects(registry);
         modern.registerBase();
         new ConfigAspects(registry).registerAll();
-- 
