+    private static Aspect compound(String tag, int color, Aspect first, Aspect second, int blend) {
+        Aspect aspect = new Aspect(tag, color, null, new Aspect[]{first, second}, blend, null);
+        BY_TAG.put(tag, aspect);
+        return aspect;
+    }
+
+    public static synchronized Aspect register(String tag, int color, Aspect @Nullable [] components, int blend, @Nullable Identifier image) {
+        if (tag == null || tag.isBlank()) {
+            throw new IllegalArgumentException("Aspect tag must not be blank");
+        }
+        if (components == null || components.length != 2 || components[0] == null || components[1] == null || image == null) {
+            throw new IllegalArgumentException("Add-on aspects require exactly two components and a texture");
+        }
+        if (BY_TAG.containsKey(tag)) {
+            throw new IllegalArgumentException(tag + " already registered!");
+        }
+        Aspect aspect = new Aspect(tag, color, null, components, blend, image);
+        BY_TAG.put(tag, aspect);
+        return aspect;
+    }
+
+    public static synchronized Aspect[] values() {
+        return BY_TAG.values().toArray(new Aspect[0]);
+    }
+
+    public static synchronized int count() {
+        return BY_TAG.size();
+    }
+
+    public static int builtinCount() {
+        return BUILTIN_COUNT;
+    }
+
+    public int ordinal() {
+        Aspect[] snapshot = values();
+        for (int index = 0; index < snapshot.length; index++) {
+            if (snapshot[index] == this) {
+                return index;
+            }
+        }
+        return -1;
+    }
+
+    public static synchronized @Nullable Aspect byOrdinal(int ordinal) {
+        if (ordinal < 0 || ordinal >= BY_TAG.size()) {
+            return null;
+        }
+        return values()[ordinal];
+    }
